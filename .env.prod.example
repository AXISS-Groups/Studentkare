# Production skeleton — fill from a vault, NEVER commit real values.
# Generate secrets with: openssl rand -hex 32
#   or: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=production
# Rule L: refuse commerce requests unless they can run as sk_commerce (TD-03).
# 0 only while the DBA creates the roles; check GET /api/ops/rule-l.
RULE_L_REQUIRE_GRANTS=1
# Real Postgres required (main.py refuses SQLite in production).
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require
ALLOWED_ORIGINS=https://<YOUR_DOMAIN>
OTP_HASH_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>

# Fail-closed feature keys. Missing = the feature is off and startup says so.
# Fernet keys: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=<FILL_VIA_VAULT_FERNET_KEY>
PASS_SIGNING_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>
DPDP_ARCHIVE_KEY=<FILL_VIA_VAULT_FERNET_KEY>
# Days a sealed erasure archive is kept before destruction. Confirm with legal counsel.
DPDP_ARCHIVE_RETENTION_DAYS=<WHOLE_NUMBER_OF_DAYS>
INTEGRATIONS_ENCRYPTION_KEY=<FILL_VIA_VAULT_FERNET_KEY>

# Payments (docs/billing-payments.md). Production refuses to start with "mock".
# Empty keys = online payment off and the app says so; nothing is charged.
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=<FILL_FROM_RAZORPAY_DASHBOARD_rzp_live_KEY_ID>
RAZORPAY_KEY_SECRET=<FILL_VIA_VAULT_RAZORPAY_KEY_SECRET>
RAZORPAY_WEBHOOK_SECRET=<FILL_VIA_VAULT_RAZORPAY_WEBHOOK_SECRET>

# Video consults on LiveKit (docs/video-consults.md). Empty = no call can be
# started and the app says so. Production accepts only a wss:// URL.
LIVEKIT_URL=<FILL_wss://YOUR_LIVEKIT_HOST>
LIVEKIT_API_KEY=<FILL_FROM_LIVEKIT_API_KEY>
LIVEKIT_API_SECRET=<FILL_VIA_VAULT_LIVEKIT_API_SECRET>
# Minutes an unpaid order holds its stock (default 30, minimum 5).
# PAYMENT_HOLD_MINUTES=30
# Never set PAYMENT_ALLOW_MOCK_IN_PRODUCTION on a public deployment.

# Optional delivery channels (leave empty = honest "unconfigured").
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=
