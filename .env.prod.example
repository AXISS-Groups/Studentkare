# Production skeleton — fill from a vault, NEVER commit real values.
# Generate secrets with: openssl rand -hex 32
#   or: python3 -c "import secrets; print(secrets.token_hex(32))"
APP_ENV=production
# Real Postgres required (main.py refuses SQLite in production).
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require
ALLOWED_ORIGINS=https://<YOUR_DOMAIN>
OTP_HASH_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>

# Fail-closed feature keys. Missing = the feature is off and startup says so.
# Fernet keys: python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
TWO_FACTOR_ENCRYPTION_KEY=<FILL_VIA_VAULT_FERNET_KEY>
PASS_SIGNING_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>
DPDP_ARCHIVE_KEY=<FILL_VIA_VAULT_FERNET_KEY>
# Days a sealed erasure archive is kept before destruction. Confirm with legal counsel.
DPDP_ARCHIVE_RETENTION_DAYS=<WHOLE_NUMBER_OF_DAYS>
INTEGRATIONS_ENCRYPTION_KEY=<FILL_VIA_VAULT_FERNET_KEY>

# Optional delivery channels (leave empty = honest "unconfigured").
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=
