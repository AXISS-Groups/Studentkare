{
  "name": "sa-care-student-health-platform",
  "private": true,
  "version": "0.5.0",
  "type": "module",
  "main": "src/native/index.ts",
  "sideEffects": [
    "./src/lib/sentry.ts",
    "./src/features/*/module.ts",
    "./src/**/*.css"
  ],
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "dev": "vite",
    "dev:demo": "vite --mode demo",
    "backend": "python scripts/start-dev-backend.py",
    "build": "tsc && vite build && node scripts/prerender-public-routes.js",
    "test": "vitest run",
    "tokens:build": "node scripts/tokens/build-tokens.mjs",
    "tokens:check": "node scripts/tokens/build-tokens.mjs --check",
    "settings:build": "python3 backend/scripts/export_public_settings.py",
    "settings:check": "python3 backend/scripts/export_public_settings.py --check",
    "icons:build": "node scripts/icons/build-icons.mjs",
    "icons:check": "node scripts/icons/build-icons.mjs --check",
    "icons:audit": "node scripts/icons/check-icons.mjs --all",
    "icons:ratchet": "node scripts/icons/check-icons.mjs --ratchet",
    "preview": "vite preview",
    "lint": "eslint --config config/eslint.config.js src",
    "lint:fix": "eslint --config config/eslint.config.js --fix src",
    "lint:ratchet": "node scripts/check-legacy-lists.mjs",
    "lint:css-colours": "node scripts/check-css-colours.mjs",
    "merge:resolve": "node scripts/git/resolve-registries.mjs",
    "check:dead-code": "knip --config config/knip.json --no-exit-code",
    "audit:all": "npm run tokens:check && npm run settings:check && npm run icons:check && npm run lint && npm run lint:ratchet && npm run lint:css-colours && tsc --noEmit && knip --config config/knip.json --no-exit-code && vitest run",
    "gen:module": "node scripts/gen-module.js",
    "start:native": "expo start",
    "start:native:ios": "expo run:ios",
    "start:native:android": "expo run:android",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build -o storybook-static"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.0",
    "@react-navigation/native-stack": "^7.0.0",
    "@sentry/browser": "^8.45.0",
    "@sentry/react": "^8.45.0",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.5",
    "expo-build-properties": "0.13.3",
    "expo-camera": "~16.0.18",
    "expo-constants": "~17.0.8",
    "expo-font": "~13.0.4",
    "expo-health-connect": "0.1.1",
    "expo-location": "~18.0.10",
    "expo-notifications": "~0.29.14",
    "expo-sensors": "14.0.2",
    "livekit-client": "2.22.3",
    "lucide-react": "^1.16.0",
    "mobx": "^7.0.3",
    "mobx-react-lite": "^5.0.3",
    "posthog-js": "^1.155.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-native": "^0.76.9",
    "react-native-health": "1.19.0",
    "react-native-health-connect": "3.3.3",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-web": "^0.19.13",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@storybook/react-vite": "^10.6.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.7.0",
    "axe-core": "^4.14.0",
    "babel-plugin-module-resolver": "^5.0.2",
    "babel-plugin-react-compiler": "19.0.0-beta-ebf51a3-20250411",
    "babel-preset-expo": "~12.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "jsdom": "^25.0.1",
    "knip": "^6.35.1",
    "playwright": "1.61.1",
    "storybook": "^10.6.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
