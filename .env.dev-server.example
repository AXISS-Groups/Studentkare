# dev.studentkare.co — the shared DEV site. Copy to the server's secret store (Dokploy env), never commit real values.
# A separate server and a separate database from production. Nothing real goes in here: no real students.
# Guide: docs/guides/dev-environment.md
APP_ENV=testing
DATABASE_URL=postgresql://studentkare:CHANGE-ME@postgres:5432/studentkare_dev?sslmode=disable
APP_DOMAIN=dev.studentkare.co
APP_BASE_URL=https://dev.studentkare.co
ALLOWED_ORIGINS=https://dev.studentkare.co

# Demo sign-in. Both are ignored unless APP_ENV is development or testing.
#   SEED_DEMO_DATA   demo.*@studentkare.test accounts, including a demo super admin, at startup.
#   DEV_OTP_CONSOLE  the fixed code 123456 for @studentkare.test accounts; other codes go to the backend log.
SEED_DEMO_DATA=true
DEV_OTP_CONSOLE=true
# Lets `python -m scripts.seed_scenarios` and `python -m scripts.open_data` write (dev only).
SEED_SCENARIOS=true
SEED_OPEN_DATA=true

# Test money only. "mock" refuses to start in production; use Razorpay rzp_test_ keys if you want the real checkout UI.
PAYMENT_PROVIDER=mock

# Required secrets: generate fresh ones for this server (openssl rand -hex 32; Fernet keys: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())").
OTP_HASH_SECRET=CHANGE-ME
TWO_FACTOR_ENCRYPTION_KEY=CHANGE-ME
PASS_SIGNING_SECRET=CHANGE-ME
DPDP_ARCHIVE_KEY=CHANGE-ME
DPDP_ARCHIVE_RETENTION_DAYS=30
INTEGRATIONS_ENCRYPTION_KEY=CHANGE-ME

# Leave these EMPTY on dev so nothing can reach a real person: WhatsApp (OpenWA), SMTP/Postal, Expo and Web Push keys.
# The staging seed refuses to run if WhatsApp is configured.
