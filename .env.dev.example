# Development defaults — SAFE to copy to `.env` for local Docker.
# NEVER use these values in production or staging.
APP_ENV=development
# SQLite on the `care-data` volume (see backend/services/db_sql.py).
DATABASE_URL=sqlite:////data/studentkare.db
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Dev-only throwaway. Generate a fresh one per checkout if you like:
#   openssl rand -hex 32
OTP_HASH_SECRET=dev-only-throwaway-replace-me

# Optional delivery channels — all empty = honest "unconfigured" state.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=
