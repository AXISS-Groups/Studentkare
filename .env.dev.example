# Development defaults — SAFE to copy to `.env` for local Docker.
# NEVER use these values in production or staging.
APP_ENV=development
# Postgres-only. Docker dev ignores this line: docker-compose.yml points the
# backend at its own `postgres` service. For the native backend, this value
# works with `docker compose up postgres` running.
# Internal Dokploy traffic stays in the private network: append ?sslmode=disable.
# External traffic must use ?sslmode=require.
DATABASE_URL=postgresql://studentkare:studentkare@localhost:5432/studentkare?sslmode=disable

# Local sign-in. Both are ignored unless APP_ENV is development or testing,
# so they can never open a shared or production deployment.
#   SEED_DEMO_DATA  creates the demo.*@studentkare.test accounts at startup.
#   DEV_OTP_CONSOLE accepts OTP 123456 for those accounts and prints other
#                   codes to the backend log instead of sending them.
SEED_DEMO_DATA=true
DEV_OTP_CONSOLE=true
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Dev-only throwaway. Generate a fresh one per checkout if you like:
#   openssl rand -hex 32
OTP_HASH_SECRET=dev-only-throwaway-replace-me

# Payments. "mock" is a labelled test gateway: test cards only, no real money.
# For Razorpay test mode set PAYMENT_PROVIDER=razorpay and the rzp_test_ keys.
PAYMENT_PROVIDER=mock
# Signs the mock's generic webhook (x-webhook-signature) if you want to replay one by hand.
# PAYMENT_WEBHOOK_SECRET=dev-only-webhook-secret
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# Optional delivery channels — all empty = honest "unconfigured" state.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=

# Monitoring stack (optional for local dev)
# GRAFANA_ADMIN_PASSWORD=admin
# ALERTMANAGER_WEBHOOK_SECRET=dev-secret-change-me

# Sentry (SaaS) — Replace with your actual DSN from sentry.io
# Get it from: Settings > Projects > [Project] > Client Keys (DSN)
# Format: https://<key>@o<org>.ingest.sentry.io/<project>
# SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456
# VITE_SENTRY_DSN=https://xxx@o123.ingest.sentry.io/456

# Native app (Expo): absolute API origin including /api, e.g. http://192.168.1.10:8000/api on a LAN.
# Expo only bundles EXPO_PUBLIC_* variables.
EXPO_PUBLIC_API_BASE_URL=
