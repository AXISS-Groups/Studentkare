{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "entry": [
    "src/main.tsx",
    "src/App.tsx",
    "src/screens/**/*.{ts,tsx}",
    "src/components/**/*.{ts,tsx}",
    "vite.config.ts"
  ],
  "project": ["src/**/*.{ts,tsx}"],
  "ignore": [
    "**/*.d.ts",
    "dist/**",
    "build/**",
    "src/types/index.ts"
  ]
}