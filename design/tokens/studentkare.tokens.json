{
  "$description": "Student Kare design tokens — the single source of truth for colour, type, space, shape, motion and interaction. W3C Design Tokens (DTCG) format: importable into Figma via Tokens Studio or a DTCG variables importer. Edit THIS file, then run `npm run tokens:build`. Never hand-edit the generated files.",
  "$extensions": { "studentkare": { "version": "1.0.0", "source": "Design canvas v5 (a11y-checked), 2026-09-25" } },
  "color": {
    "$type": "color",
    "light": {
      "canvas":        { "$value": "#FAF8FF", "$description": "App background" },
      "surface":       { "$value": "#FFFFFF", "$description": "Cards, sheets, inputs" },
      "surface-2":     { "$value": "#F2F3FF", "$description": "Recessed / grouped surfaces" },
      "surface-3":     { "$value": "#EEF2FF", "$description": "Selected rows, icon tiles, info notes" },
      "rule":          { "$value": "#DAE2FD", "$description": "Borders, dividers, input outlines" },
      "rule-soft":     { "$value": "#EEF2FF", "$description": "Hairlines inside cards" },
      "rule-strong":   { "$value": "#918F9E", "$description": "Outline of an interactive field or control. Darker than `rule` because WCAG 1.4.11 needs 3:1 for a UI component boundary, and a divider does not." },
      "text":          { "$value": "#131B2E", "$description": "Headings and primary text" },
      "text-2":        { "$value": "#464555", "$description": "Body and secondary text" },
      "text-3":        { "$value": "#6B6980", "$description": "Meta, captions, timestamps (minimum contrast for text)" },
      "brand-navy":    { "$value": "#0C0494", "$description": "Brand navy (founder, 2026-10-20) — landing heroes, footers, dark panels, toasts. Same value as action, nav-bg, sidebar and hero-bg" },
      "sidebar":       { "$value": "#0C0494", "$description": "Console sidebar (Super Admin, vendor and clinician shells) — brand navy" },
      "sidebar-active":{ "$value": "#FFFFFF", "$description": "Current page fill on the sidebar: the white pill (founder, 2026-10-20). Its label and icon are on-nav-current (navy), never sidebar-ink" },
      "sidebar-ink":   { "$value": "#FFFFFF", "$description": "Brand name and hovered link text on the sidebar. Not the current page: that label sits on the white pill in on-nav-current" },
      "sidebar-ink-2": { "$value": "#C3C0FF", "$description": "Links on the sidebar" },
      "sidebar-ink-3": { "$value": "#A9A5E0", "$description": "Section labels on the sidebar" },
      "action":        { "$value": "#0C0494", "$description": "Primary buttons, links, selected state — brand navy" },
      "action-hover":  { "$value": "#1D10D6" },
      "on-action":     { "$value": "#FFFFFF", "$description": "Text/icons on action and status fills" },
      "action-soft":   { "$value": "#DAE2FD", "$description": "Disabled button fill" },
      "focus":         { "$value": "#6C68F0", "$description": "Keyboard focus ring (3px, 3px offset). >= 3:1 on light surfaces AND on the navy (nav-bg, sidebar, brand-navy, hero-bg), and on the white nav pill (nav-current, sidebar-active), so one ring works everywhere" },
      "positive":      { "$value": "#047857", "$description": "Success, verified, in range" },
      "positive-fill": { "$value": "#10B981", "$description": "Success icons/ticks (never as text colour)" },
      "positive-bg":   { "$value": "#ECFDF5" },
      "attention":     { "$value": "#B45309", "$description": "Needs attention, outside range, pending. Never red for a result." },
      "attention-bg":  { "$value": "#FFFBEB" },
      "danger":        { "$value": "#BE123C", "$description": "Errors, destructive actions, mismatch, crisis links" },
      "danger-fill":   { "$value": "#E11D48", "$description": "Danger buttons and SOS fills" },
      "danger-bg":     { "$value": "#FFF1F2" },
      "info":          { "$value": "#312E81", "$description": "Text on info notes (surface-3)" },
      "clinical-value":{ "$value": "#131B2E", "$description": "Lab values and vitals — always set in the mono font" },
      "neutral-bg":    { "$value": "#F2F3F9", "$description": "Neutral status pills and tiles (not offered, ended, break)" },
      "on-danger-fill":{ "$value": "#FFFFFF", "$description": "Text on danger-fill (count badges, danger buttons)" },
      "danger-rule":   { "$value": "#FECDD3", "$description": "Border of an error card or a danger-toned card" },
      "positive-rule": { "$value": "#6EE7B7", "$description": "Border of a positive pill that is also a control (availability)" },
      "selected-rule": { "$value": "#818CF8", "$description": "Border of the current item in a list (next consult). Always paired with a surface-3 fill, never the only cue" },
      "skeleton":      { "$value": "#ECEEF8", "$description": "Loading skeleton base" },
      "skeleton-shine":{ "$value": "#F7F8FD", "$description": "Loading skeleton highlight" },
      "nav-bg":        { "$value": "#0C0494", "$description": "Console sidebar (clinician, partner, campus, admin) — brand navy" },
      "nav-text":      { "$value": "#C3C0FF", "$description": "Sidebar links" },
      "nav-label":     { "$value": "#A9A5E0", "$description": "Sidebar group labels" },
      "nav-current":   { "$value": "#FFFFFF", "$description": "Sidebar current page fill: the white pill on the navy (founder, 2026-10-20). Only for the selected item on a navy nav surface; never a light-surface accent, text, button or marker (use action)" },
      "on-nav-current":{ "$value": "#0C0494", "$description": "Label and icon of the current item on the white pill (nav-current / sidebar-active): the navy" },
      "hero-bg":       { "$value": "#0C0494", "$description": "Hero and feature panels (founder's navy, 2026-10-20). Stays dark in both schemes. Not a full-screen canvas" },
      "hero-bg-top":   { "$value": "#0C0494", "$description": "Hero gradient start. Equal to hero-bg, so hero panels are flat navy; a lighter start needs its own contrast check" },
      "hero-current":  { "$value": "#FFFFFF", "$description": "The only selected/current indicator allowed on a hero panel (a white pill). White pill + navy text is the selected state on every navy surface" },
      "on-hero-current":{ "$value": "#0C0494", "$description": "Text and icons on hero-current" },
      "on-hero":       { "$value": "#FFFFFF" },
      "on-hero-2":     { "$value": "#C7D2FE", "$description": "Secondary text on the hero" },
      "on-hero-label": { "$value": "#A5B4FC", "$description": "Eyebrow on the hero" },
      "on-hero-positive":{ "$value": "#6EE7B7", "$description": "Positive pill text on the hero" }
    },
    "dark": {
      "canvas":        { "$value": "#0E1428" },
      "surface":       { "$value": "#171F38" },
      "surface-2":     { "$value": "#202A48" },
      "surface-3":     { "$value": "#2E3862" },
      "rule":          { "$value": "#354161" },
      "rule-soft":     { "$value": "#283350" },
      "rule-strong":   { "$value": "#56699D" },
      "text":          { "$value": "#EEF2FF" },
      "text-2":        { "$value": "#BCC7E2" },
      "text-3":        { "$value": "#A5B1CE" },
      "brand-navy":    { "$value": "#0C0494" },
      "sidebar":       { "$value": "#0C0494" },
      "sidebar-active":{ "$value": "#FFFFFF" },
      "sidebar-ink":   { "$value": "#FFFFFF" },
      "sidebar-ink-2": { "$value": "#C3C0FF" },
      "sidebar-ink-3": { "$value": "#A9A5E0" },
      "action":        { "$value": "#A5B4FC" },
      "action-hover":  { "$value": "#C7D2FE" },
      "on-action":     { "$value": "#131B2E" },
      "action-soft":   { "$value": "#2E3862" },
      "focus":         { "$value": "#7F7BF5", "$description": "Dark focus ring: >= 3:1 on every dark surface, on the navy AND on the white nav pill (#A5B4FC was 2.0:1 on the pill)" },
      "positive":      { "$value": "#6EE7B7" },
      "positive-fill": { "$value": "#10B981" },
      "positive-bg":   { "$value": "#0F2E26" },
      "attention":     { "$value": "#FCD34D" },
      "attention-bg":  { "$value": "#33280F" },
      "danger":        { "$value": "#FDA4AF" },
      "danger-fill":   { "$value": "#E11D48" },
      "danger-bg":     { "$value": "#3A1420" },
      "info":          { "$value": "#C7D2FE" },
      "clinical-value":{ "$value": "#EEF2FF" },
      "neutral-bg":    { "$value": "#283350" },
      "on-danger-fill":{ "$value": "#FFFFFF" },
      "danger-rule":   { "$value": "#5B2130" },
      "positive-rule": { "$value": "#2F6B57" },
      "selected-rule": { "$value": "#818CF8" },
      "skeleton":      { "$value": "#202A48" },
      "skeleton-shine":{ "$value": "#2E3862" },
      "nav-bg":        { "$value": "#0C0494" },
      "nav-text":      { "$value": "#C3C0FF" },
      "nav-label":     { "$value": "#A9A5E0" },
      "nav-current":   { "$value": "#FFFFFF" },
      "on-nav-current":{ "$value": "#0C0494" },
      "hero-bg":       { "$value": "#0C0494" },
      "hero-bg-top":   { "$value": "#0C0494" },
      "hero-current":  { "$value": "#FFFFFF" },
      "on-hero-current":{ "$value": "#0C0494" },
      "on-hero":       { "$value": "#FFFFFF" },
      "on-hero-2":     { "$value": "#C7D2FE" },
      "on-hero-label": { "$value": "#A5B4FC" },
      "on-hero-positive":{ "$value": "#6EE7B7" }
    }
  },
  "contrast-minimum": {
    "$description": "WCAG 2.1 AA minimum contrast ratios, named once. contrast-pairs refer to them by name; tests read them from skTokens.contrastMinimum.",
    "text":     { "$value": 4.5, "$description": "Body text and icons that carry meaning (WCAG 1.4.3)" },
    "non-text": { "$value": 3, "$description": "Large text, UI components, focus and selected indicators (WCAG 1.4.3 large text, 1.4.11)" }
  },
  "contrast-pairs": {
    "$description": "Every text/background pair used in the product, with the contrast-minimum it must meet. The token test fails if any pair drops below it.",
    "$value": [
      ["text", "canvas", "text"], ["text", "surface", "text"], ["text-2", "surface", "text"], ["text-3", "surface", "text"],
      ["text-3", "canvas", "text"], ["text-2", "surface-2", "text"], ["on-action", "action", "text"], ["action", "surface", "text"],
      ["positive", "positive-bg", "text"], ["attention", "attention-bg", "text"], ["danger", "danger-bg", "text"],
      ["info", "surface-3", "text"], ["danger", "surface", "text"], ["positive", "surface", "text"], ["attention", "surface", "text"],
      ["focus", "surface", "non-text"], ["rule-strong", "surface", "non-text"], ["rule-strong", "canvas", "non-text"],
      ["action", "surface-3", "text"], ["text-2", "neutral-bg", "text"], ["on-danger-fill", "danger-fill", "text"],
      ["nav-text", "nav-bg", "text"], ["nav-label", "nav-bg", "text"], ["on-nav-current", "nav-current", "text"],
      ["on-hero", "hero-bg-top", "text"], ["on-hero-2", "hero-bg-top", "text"], ["on-hero-label", "hero-bg-top", "text"],
      ["on-hero-positive", "hero-bg-top", "text"], ["hero-bg", "on-hero", "text"],
      ["on-hero", "hero-bg", "text"], ["on-hero-2", "hero-bg", "text"], ["on-hero-label", "hero-bg", "text"],
      ["on-hero-positive", "hero-bg", "text"], ["hero-current", "hero-bg", "non-text"], ["on-hero-current", "hero-current", "text"],
      ["sidebar-ink", "sidebar", "text"], ["sidebar-ink-2", "sidebar", "text"], ["sidebar-ink-3", "sidebar", "text"], ["on-nav-current", "sidebar-active", "text"],
      ["on-action", "action-hover", "text"], ["action", "canvas", "text"], ["action", "action-soft", "text"],
      ["nav-current", "nav-bg", "non-text"], ["sidebar-active", "sidebar", "non-text"],
      ["focus", "canvas", "non-text"], ["focus", "nav-bg", "non-text"], ["focus", "sidebar", "non-text"], ["focus", "brand-navy", "non-text"], ["focus", "hero-bg", "non-text"],
      ["sidebar-ink", "brand-navy", "text"], ["sidebar-ink-2", "brand-navy", "text"], ["sidebar-ink-3", "brand-navy", "text"],
      ["on-hero", "brand-navy", "text"], ["on-hero-2", "brand-navy", "text"],
      ["focus", "nav-current", "non-text"], ["focus", "sidebar-active", "non-text"]
    ]
  },
  "font": {
    "family": {
      "$type": "fontFamily",
      "sans":   { "$value": ["Plus Jakarta Sans", "Noto Sans Telugu", "Noto Sans Devanagari", "Manrope", "system-ui", "sans-serif"], "$description": "All UI text. Telugu and Devanagari glyphs fall through to the Noto faces (DESIGN.md §3)." },
      "serif":  { "$value": ["Georgia", "serif"], "$description": "Only the italic ‘Kare’ in the wordmark" },
      "mono":   { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Clinical values, codes, IDs, times in logs" },
      "telugu": { "$value": ["Noto Sans Telugu", "Plus Jakarta Sans", "sans-serif"] },
      "hindi":  { "$value": ["Noto Sans Devanagari", "Plus Jakarta Sans", "sans-serif"] }
    },
    "size": {
      "$type": "dimension",
      "caption":  { "$value": "12px" },
      "body-sm":  { "$value": "13.5px" },
      "body":     { "$value": "15px" },
      "title-sm": { "$value": "17px" },
      "title":    { "$value": "20px" },
      "heading":  { "$value": "26px" },
      "display":  { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 500 }, "strong": { "$value": 700 }, "heavy": { "$value": 800 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 }, "body": { "$value": 1.55 }
    },
    "eyebrow": {
      "$description": "Small uppercase section labels: caption size, weight 800, letter-spacing 1px, colour text-2",
      "letter-spacing": { "$type": "dimension", "$value": "1px" }
    }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": "2px" }, "4": { "$value": "4px" }, "6": { "$value": "6px" }, "8": { "$value": "8px" },
    "10": { "$value": "10px" }, "12": { "$value": "12px" }, "14": { "$value": "14px" }, "16": { "$value": "16px" },
    "20": { "$value": "20px" }, "24": { "$value": "24px" }, "32": { "$value": "32px" }, "40": { "$value": "40px" },
    "gutter-phone": { "$value": "20px", "$description": "Horizontal page padding on phones (min 16px)" },
    "gutter-web":   { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "8px",  "$description": "Chips inside cards, small tags" },
    "md":   { "$value": "12px", "$description": "Notes, small buttons" },
    "lg":   { "$value": "14px", "$description": "Inputs and primary buttons" },
    "xl":   { "$value": "20px", "$description": "Cards" },
    "sheet":{ "$value": "28px", "$description": "Bottom sheets and drawers (top corners only)" },
    "full": { "$value": "999px", "$description": "Pills, avatars, badges" }
  },
  "size": {
    "$type": "dimension",
    "touch-target":   { "$value": "44px", "$description": "Minimum hit area for anything tappable (AGENTS.md rule 7)" },
    "control":        { "$value": "50px", "$description": "Input and default button height" },
    "control-lg":     { "$value": "54px", "$description": "Primary call-to-action height" },
    "phone-width":    { "$value": "390px" },
    "panel-max":      { "$value": "640px", "$description": "Widest a single-column account or settings panel grows on the web" },
    "web-content-max":{ "$value": "1440px" },
    "web-sidebar":    { "$value": "260px" }
  },
  "shadow": {
    "$type": "shadow",
    "card":  { "$value": { "color": "#13192E14", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" } },
    "float": { "$value": { "color": "#13192E26", "offsetX": "0px", "offsetY": "14px", "blur": "30px", "spread": "0px" } },
    "sheet": { "$value": { "color": "#13192E40", "offsetX": "0px", "offsetY": "-20px","blur": "50px", "spread": "0px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms", "$description": "Taps, toggles" },
      "base": { "$value": "320ms", "$description": "Page and card entrances" },
      "sheet":{ "$value": "420ms", "$description": "Sheets and drawers" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.16, 1, 0.3, 1] },
      "sheet":    { "$value": [0.2, 0.8, 0.3, 1] }
    },
    "rule": { "$description": "All motion stops under prefers-reduced-motion. Never animate or celebrate anything about the body (no confetti on results, vitals or diagnoses)." }
  }
}
