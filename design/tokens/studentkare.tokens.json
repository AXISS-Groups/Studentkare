      "body-sm":  { "$value": "13.5px" },
      "body":     { "$value": "15px" },
      "title-sm": { "$value": "17px" },
      "title":    { "$value": "20px" },
      "heading":  { "$value": "26px" },
      "display":  { "$value": "32px" }
    },
    "weight": {
      "$type": "fontWeight",
      "regular": { "$value": 500 }, "strong": { "$value": 700 }, "heavy": { "$value": 800 }
    },
    "line-height": {
      "$type": "number",
      "tight": { "$value": 1.2 }, "body": { "$value": 1.55 }
    },
    "eyebrow": {
      "$description": "Small uppercase section labels: caption size, weight 800, letter-spacing 1px, colour text-2",
      "letter-spacing": { "$type": "dimension", "$value": "1px" }
    }
  },
  "space": {
    "$type": "dimension",
    "2": { "$value": "2px" }, "4": { "$value": "4px" }, "6": { "$value": "6px" }, "8": { "$value": "8px" },
    "10": { "$value": "10px" }, "12": { "$value": "12px" }, "14": { "$value": "14px" }, "16": { "$value": "16px" },
    "20": { "$value": "20px" }, "24": { "$value": "24px" }, "32": { "$value": "32px" }, "40": { "$value": "40px" },
    "gutter-phone": { "$value": "20px", "$description": "Horizontal page padding on phones (min 16px)" },
    "gutter-web":   { "$value": "40px" }
  },
  "radius": {
    "$type": "dimension",
    "sm":   { "$value": "8px",  "$description": "Chips inside cards, small tags" },
    "md":   { "$value": "12px", "$description": "Notes, small buttons" },
    "lg":   { "$value": "14px", "$description": "Inputs and primary buttons" },
    "xl":   { "$value": "20px", "$description": "Cards" },
    "sheet":{ "$value": "28px", "$description": "Bottom sheets and drawers (top corners only)" },
    "full": { "$value": "999px", "$description": "Pills, avatars, badges" }
  },
  "size": {
    "$type": "dimension",
    "touch-target":   { "$value": "44px", "$description": "Minimum hit area for anything tappable (AGENTS.md rule 7)" },
    "control":        { "$value": "50px", "$description": "Input and default button height" },
    "control-lg":     { "$value": "54px", "$description": "Primary call-to-action height" },
    "phone-width":    { "$value": "390px" },
    "panel-max":      { "$value": "640px", "$description": "Widest a single-column account or settings panel grows on the web" },
    "web-content-max":{ "$value": "1440px" },
    "web-sidebar":    { "$value": "260px" }
  },
  "shadow": {
    "$type": "shadow",
    "hairline": { "$value": { "color": "#13192E14", "offsetX": "0px", "offsetY": "1px", "blur": "4px", "spread": "0px" }, "$description": "The small lift under chips, pills, small buttons and rows (any shadow with under 12px blur). Not a boundary: pair with a rule border where the edge matters" },
    "card":  { "$value": { "color": "#13192E14", "offsetX": "0px", "offsetY": "8px",  "blur": "24px", "spread": "0px" } },
    "float": { "$value": { "color": "#13192E26", "offsetX": "0px", "offsetY": "14px", "blur": "30px", "spread": "0px" } },
    "sheet": { "$value": { "color": "#13192E40", "offsetX": "0px", "offsetY": "-20px","blur": "50px", "spread": "0px" } }
  },
  "motion": {
    "duration": {
      "$type": "duration",
      "fast": { "$value": "160ms", "$description": "Taps, toggles" },
      "base": { "$value": "320ms", "$description": "Page and card entrances" },
      "sheet":{ "$value": "420ms", "$description": "Sheets and drawers" }
    },
    "easing": {
      "$type": "cubicBezier",
      "standard": { "$value": [0.16, 1, 0.3, 1] },
      "sheet":    { "$value": [0.2, 0.8, 0.3, 1] }
    },
    "rule": { "$description": "All motion stops under prefers-reduced-motion. Never animate or celebrate anything about the body (no confetti on results, vitals or diagnoses)." }
  }
}
