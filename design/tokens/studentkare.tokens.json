  "contrast-minimum": {
    "$description": "WCAG 2.1 AA minimum contrast ratios, named once. contrast-pairs refer to them by name; tests read them from skTokens.contrastMinimum.",
    "text":     { "$value": 4.5, "$description": "Body text and icons that carry meaning (WCAG 1.4.3)" },
    "non-text": { "$value": 3, "$description": "Large text, UI components, focus and selected indicators (WCAG 1.4.3 large text, 1.4.11)" }
  },
  "contrast-pairs": {
    "$description": "Every text/background pair used in the product, with the contrast-minimum it must meet. The token test fails if any pair drops below it.",
    "$value": [
      ["text", "canvas", "text"], ["text", "surface", "text"], ["text-2", "surface", "text"], ["text-3", "surface", "text"],
      ["text-3", "canvas", "text"], ["text-2", "surface-2", "text"], ["on-action", "action", "text"], ["action", "surface", "text"],
      ["positive", "positive-bg", "text"], ["attention", "attention-bg", "text"], ["danger", "danger-bg", "text"],
      ["info", "surface-3", "text"], ["danger", "surface", "text"], ["positive", "surface", "text"], ["attention", "surface", "text"],
      ["focus", "surface", "non-text"], ["rule-strong", "surface", "non-text"], ["rule-strong", "canvas", "non-text"],
      ["action", "surface-3", "text"], ["text-2", "neutral-bg", "text"], ["on-danger-fill", "danger-fill", "text"],
      ["nav-text", "nav-bg", "text"], ["nav-label", "nav-bg", "text"], ["on-nav-current", "nav-current", "text"],
      ["on-hero", "hero-bg-top", "text"], ["on-hero-2", "hero-bg-top", "text"], ["on-hero-label", "hero-bg-top", "text"],
      ["on-hero-positive", "hero-bg-top", "text"], ["hero-bg", "on-hero", "text"],
      ["on-hero", "hero-bg", "text"], ["on-hero-2", "hero-bg", "text"], ["on-hero-label", "hero-bg", "text"],
      ["on-hero-positive", "hero-bg", "text"], ["hero-current", "hero-bg", "non-text"], ["on-hero-current", "hero-current", "text"],
      ["sidebar-ink", "sidebar", "text"], ["sidebar-ink-2", "sidebar", "text"], ["sidebar-ink-3", "sidebar", "text"], ["on-nav-current", "sidebar-active", "text"],
      ["on-action", "action-hover", "text"], ["action", "canvas", "text"], ["action", "action-soft", "text"],
      ["nav-current", "nav-bg", "non-text"], ["sidebar-active", "sidebar", "non-text"],
      ["focus", "canvas", "non-text"], ["focus", "nav-bg", "non-text"], ["focus", "sidebar", "non-text"], ["focus", "brand-navy", "non-text"], ["focus", "hero-bg", "non-text"],
      ["sidebar-ink", "brand-navy", "text"], ["sidebar-ink-2", "brand-navy", "text"], ["sidebar-ink-3", "brand-navy", "text"],
      ["on-hero", "brand-navy", "text"], ["on-hero-2", "brand-navy", "text"],
      ["focus", "nav-current", "non-text"], ["focus", "sidebar-active", "non-text"],
      ["on-hero-attention", "hero-bg", "text"], ["on-hero-attention", "brand-navy", "text"],
      ["nav-danger", "nav-bg", "text"], ["nav-danger", "sidebar", "text"], ["nav-danger", "brand-navy", "text"],
      ["paper-ink", "paper", "text"], ["paper-ink-2", "paper", "text"], ["qr-foreground", "qr-background", "text"],
      ["chart-categorical-1", "canvas", "non-text"], ["chart-categorical-2", "canvas", "non-text"], ["chart-categorical-3", "canvas", "non-text"], ["chart-categorical-4", "canvas", "non-text"],
      ["chart-categorical-5", "canvas", "non-text"], ["chart-categorical-6", "canvas", "non-text"], ["chart-categorical-7", "canvas", "non-text"], ["chart-categorical-8", "canvas", "non-text"],
      ["chart-categorical-1", "surface", "non-text"], ["chart-categorical-2", "surface", "non-text"], ["chart-categorical-3", "surface", "non-text"], ["chart-categorical-4", "surface", "non-text"],
      ["chart-categorical-5", "surface", "non-text"], ["chart-categorical-6", "surface", "non-text"], ["chart-categorical-7", "surface", "non-text"], ["chart-categorical-8", "surface", "non-text"]
    ]
  },
