      "serif":  { "$value": ["Georgia", "serif"], "$description": "Only the italic ‘Kare’ in the wordmark" },
      "mono":   { "$value": ["IBM Plex Mono", "ui-monospace", "monospace"], "$description": "Clinical values, codes, IDs, times in logs" },
      "telugu": { "$value": ["Noto Sans Telugu", "Plus Jakarta Sans", "sans-serif"] },
      "hindi":  { "$value": ["Noto Sans Devanagari", "Plus Jakarta Sans", "sans-serif"] }
    },
