{
  "$description": "Student Kare design tokens — the single source of truth for colour, type, space, shape, motion and interaction. W3C Design Tokens (DTCG) format: importable into Figma via Tokens Studio or a DTCG variables importer. Edit THIS file, then run `npm run tokens:build`. Never hand-edit the generated files.",
  "$extensions": { "studentkare": { "version": "1.0.0", "source": "Design canvas v5 (a11y-checked), 2026-09-25" } },
  "color": {
    "$type": "color",
    "light": {
      "canvas":        { "$value": "#FAF8FF", "$description": "App background" },
      "surface":       { "$value": "#FFFFFF", "$description": "Cards, sheets, inputs" },
      "surface-2":     { "$value": "#F2F3FF", "$description": "Recessed / grouped surfaces" },
      "surface-3":     { "$value": "#EEF2FF", "$description": "Selected rows, icon tiles, info notes" },
      "rule":          { "$value": "#DAE2FD", "$description": "Borders, dividers, input outlines" },
      "rule-soft":     { "$value": "#EEF2FF", "$description": "Hairlines inside cards" },
      "rule-strong":   { "$value": "#918F9E", "$description": "Outline of an interactive field or control. Darker than `rule` because WCAG 1.4.11 needs 3:1 for a UI component boundary, and a divider does not." },
      "text":          { "$value": "#131B2E", "$description": "Headings and primary text" },
      "text-2":        { "$value": "#464555", "$description": "Body and secondary text" },
      "text-3":        { "$value": "#6B6980", "$description": "Meta, captions, timestamps (minimum contrast for text)" },
      "brand-navy":    { "$value": "#0C0494", "$description": "Brand navy (founder, 2026-10-20) — landing heroes, footers, dark panels, toasts. Same value as action, nav-bg, sidebar and hero-bg" },
      "sidebar":       { "$value": "#0C0494", "$description": "Console sidebar (Super Admin, vendor and clinician shells) — brand navy" },
      "sidebar-active":{ "$value": "#FFFFFF", "$description": "Current page fill on the sidebar: the white pill (founder, 2026-10-20). Its label and icon are on-nav-current (navy), never sidebar-ink" },
      "sidebar-ink":   { "$value": "#FFFFFF", "$description": "Brand name and hovered link text on the sidebar. Not the current page: that label sits on the white pill in on-nav-current" },
      "sidebar-ink-2": { "$value": "#C3C0FF", "$description": "Links on the sidebar" },
      "sidebar-ink-3": { "$value": "#A9A5E0", "$description": "Section labels on the sidebar" },
      "action":        { "$value": "#0C0494", "$description": "Primary buttons, links, selected state — brand navy" },
      "action-hover":  { "$value": "#1D10D6" },
      "on-action":     { "$value": "#FFFFFF", "$description": "Text/icons on action and status fills" },
      "action-soft":   { "$value": "#DAE2FD", "$description": "Disabled button fill" },
      "focus":         { "$value": "#6C68F0", "$description": "Keyboard focus ring (3px, 3px offset). >= 3:1 on light surfaces AND on the navy (nav-bg, sidebar, brand-navy, hero-bg), and on the white nav pill (nav-current, sidebar-active), so one ring works everywhere" },
      "positive":      { "$value": "#047857", "$description": "Success, verified, in range" },
      "positive-fill": { "$value": "#10B981", "$description": "Success icons/ticks (never as text colour)" },
      "positive-bg":   { "$value": "#ECFDF5" },
      "attention":     { "$value": "#B45309", "$description": "Needs attention, outside range, pending. Never red for a result." },
      "attention-bg":  { "$value": "#FFFBEB" },
      "danger":        { "$value": "#BE123C", "$description": "Errors, destructive actions, mismatch, crisis links" },
      "danger-fill":   { "$value": "#E11D48", "$description": "Danger buttons and SOS fills" },
      "danger-bg":     { "$value": "#FFF1F2" },
      "info":          { "$value": "#312E81", "$description": "Text on info notes (surface-3)" },
      "clinical-value":{ "$value": "#131B2E", "$description": "Lab values and vitals — always set in the mono font" },
      "neutral-bg":    { "$value": "#F2F3F9", "$description": "Neutral status pills and tiles (not offered, ended, break)" },
      "on-danger-fill":{ "$value": "#FFFFFF", "$description": "Text on danger-fill (count badges, danger buttons)" },
      "danger-rule":   { "$value": "#FECDD3", "$description": "Border of an error card or a danger-toned card" },
      "positive-rule": { "$value": "#6EE7B7", "$description": "Border of a positive pill that is also a control (availability)" },
      "selected-rule": { "$value": "#818CF8", "$description": "Border of the current item in a list (next consult). Always paired with a surface-3 fill, never the only cue" },
      "skeleton":      { "$value": "#ECEEF8", "$description": "Loading skeleton base" },
      "skeleton-shine":{ "$value": "#F7F8FD", "$description": "Loading skeleton highlight" },
      "nav-bg":        { "$value": "#0C0494", "$description": "Console sidebar (clinician, partner, campus, admin) — brand navy" },
      "nav-text":      { "$value": "#C3C0FF", "$description": "Sidebar links" },
      "nav-label":     { "$value": "#A9A5E0", "$description": "Sidebar group labels" },
      "nav-current":   { "$value": "#FFFFFF", "$description": "Sidebar current page fill: the white pill on the navy (founder, 2026-10-20). Only for the selected item on a navy nav surface; never a light-surface accent, text, button or marker (use action)" },
      "on-nav-current":{ "$value": "#0C0494", "$description": "Label and icon of the current item on the white pill (nav-current / sidebar-active): the navy" },
      "hero-bg":       { "$value": "#0C0494", "$description": "Hero and feature panels (founder's navy, 2026-10-20). Stays dark in both schemes. Not a full-screen canvas" },
      "hero-bg-top":   { "$value": "#0C0494", "$description": "Hero gradient start. Equal to hero-bg, so hero panels are flat navy; a lighter start needs its own contrast check" },
      "hero-current":  { "$value": "#FFFFFF", "$description": "The only selected/current indicator allowed on a hero panel (a white pill). White pill + navy text is the selected state on every navy surface" },
      "on-hero-current":{ "$value": "#0C0494", "$description": "Text and icons on hero-current" },
      "on-hero":       { "$value": "#FFFFFF" },
      "on-hero-2":     { "$value": "#C7D2FE", "$description": "Secondary text on the hero" },
      "on-hero-label": { "$value": "#A5B4FC", "$description": "Eyebrow on the hero" },
      "on-hero-positive":{ "$value": "#6EE7B7", "$description": "Positive pill text on the hero" },
      "on-hero-attention":{ "$value": "#FCD34D", "$description": "Amber text/icon on the navy (pending, needs attention). AA on hero-bg, brand-navy, nav-bg and sidebar" },
      "on-hero-veil":  { "$value": "#FFFFFF1A", "$description": "Subtle translucent fill on the navy (chips, inset tiles). on-hero and on-hero-2 stay AA on it" },
      "on-hero-track": { "$value": "#FFFFFF33", "$description": "Unfilled progress track on the navy; the filled part is on-hero (>= 3:1 against the track)" },
      "on-hero-rule":  { "$value": "#FFFFFF1F", "$description": "Hairline divider on the navy. Decorative: never the only boundary of a control" },
      "on-action-2":   { "$value": "#FFFFFFBF", "$description": "Muted secondary text on an action fill (button subtitle, price note). AA on action and action-hover" },
      "nav-danger":    { "$value": "#FDA4AF", "$description": "Destructive link text on the navy sidebar (sign out). AA on nav-bg / sidebar / brand-navy" },
      "action-highlight":{ "$value": "#FFFFFF3D", "$description": "Inset top highlight on primary buttons. Decorative" },
      "scrim":         { "$value": "#0B10208C", "$description": "Modal, sheet and drawer overlay" },
      "scrim-strong":  { "$value": "#0B1020B8", "$description": "Blocking overlay (gate, full-screen dialog) where the page behind must not be read" },
      "chart-categorical-1": { "$value": "#3B2FC9", "$description": "Series 1 (navy family). Categorical marks: >= 3:1 on canvas and surface; spread in lightness so series stay apart under colour-vision deficiency. Use in order; beyond 4 series also label directly or vary marker shape" },
      "chart-categorical-2": { "$value": "#C2780A", "$description": "Series 2 (amber)" },
      "chart-categorical-3": { "$value": "#1F8A70", "$description": "Series 3 (teal)" },
      "chart-categorical-4": { "$value": "#8A1550", "$description": "Series 4 (wine)" },
      "chart-categorical-5": { "$value": "#3A86C8", "$description": "Series 5 (sky)" },
      "chart-categorical-6": { "$value": "#5E2E0F", "$description": "Series 6 (brown)" },
      "chart-categorical-7": { "$value": "#7E2E9E", "$description": "Series 7 (purple)" },
      "chart-categorical-8": { "$value": "#5A6E00", "$description": "Series 8 (olive)" },
      "illustration-indigo-soft": { "$value": "#C7D2FE", "$description": "Landing/marketing illustrations only (never UI, text or status). Indigo family: soft tint" },
      "illustration-indigo":      { "$value": "#4F46E5", "$description": "Illustration indigo" },
      "illustration-indigo-deep": { "$value": "#0C0494", "$description": "Illustration navy: the brand navy for shading and dark shapes" },
      "illustration-mint-soft":   { "$value": "#B8F7DA" },
      "illustration-mint":        { "$value": "#34D399" },
      "illustration-mint-deep":   { "$value": "#047857" },
      "illustration-gold-soft":   { "$value": "#FFE39A" },
      "illustration-gold":        { "$value": "#F5B83D" },
      "illustration-gold-deep":   { "$value": "#C98512" },
      "illustration-peach-soft":  { "$value": "#FFE0C2" },
      "illustration-peach":       { "$value": "#FDBA74" },
      "illustration-peach-deep":  { "$value": "#EA7A2E" },
      "illustration-rose-soft":   { "$value": "#FFE4E6" },
      "illustration-rose":        { "$value": "#F49AA8" },
      "illustration-rose-deep":   { "$value": "#C4566B", "$description": "Illustration rose shading. Not danger: never for errors or alerts" },
      "illustration-sky-soft":    { "$value": "#E0F2FE" },
      "illustration-sky":         { "$value": "#38BDF8" },
      "illustration-sky-deep":    { "$value": "#0284C7" },
      "illustration-ink":         { "$value": "#1E1B4B", "$description": "Dark outline and detail ink in illustrations" },
