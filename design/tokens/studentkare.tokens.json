      "illustration-highlight":   { "$value": "#FFFFFF", "$description": "Specular highlight / white shapes in illustrations" },
      "art-tint-1":    { "$value": "#6C7CBD", "$description": "Product/category art tint (indigo). Decorative fills in marketplace product art and category tiles; never text or status" },
      "art-tint-2":    { "$value": "#8F7DC4", "$description": "Art tint (lavender)" },
      "art-tint-3":    { "$value": "#BD8B9E", "$description": "Art tint (mauve)" },
      "art-tint-4":    { "$value": "#C88781", "$description": "Art tint (rose clay)" },
      "art-tint-5":    { "$value": "#DFA061", "$description": "Art tint (amber)" },
      "art-tint-6":    { "$value": "#B6A06F", "$description": "Art tint (khaki)" },
      "art-tint-7":    { "$value": "#8FB8A8", "$description": "Art tint (sage)" },
      "art-tint-8":    { "$value": "#6FA2AA", "$description": "Art tint (teal)" },
      "decor-1":       { "$value": "#E8A317", "$description": "Celebration accent (confetti) gold. Decorative only, aria-hidden; never on a health result (DESIGN.md §2)" },
      "decor-2":       { "$value": "#10B981", "$description": "Celebration accent mint" },
      "decor-3":       { "$value": "#6366F1", "$description": "Celebration accent indigo" },
      "decor-4":       { "$value": "#F97316", "$description": "Celebration accent orange" },
      "decor-5":       { "$value": "#EC4899", "$description": "Celebration accent pink" },
      "paper":         { "$value": "#FFFDF7", "$description": "Paper prescription sheet. Stays paper-light in dark mode (a picture of a physical document; dark ink on light paper is what a pharmacist checks against)" },
      "paper-rule":    { "$value": "#E2D9BF", "$description": "Border and divider on the paper sheet. Decorative" },
      "paper-ink":     { "$value": "#1E3A5F", "$description": "Handwriting and doctor name on the paper sheet. AA on paper in both schemes" },
      "paper-ink-2":   { "$value": "#475569", "$description": "Printed meta on the paper sheet. AA on paper in both schemes" },
      "qr-foreground": { "$value": "#000000", "$description": "QR code modules. Never inverts in dark mode (Tier 1 review: inverted QR is a scan risk)" },
      "qr-background": { "$value": "#FFFFFF", "$description": "QR code quiet zone and background. Never inverts in dark mode" }
    },
