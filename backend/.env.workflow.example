# Load this file explicitly with uvicorn --env-file after providing real settings.
APP_ENV=development
# DATABASE_URL defaults to backend/studentkare.db (persistent SQLite).
# Production example: postgresql+psycopg://USER:PASSWORD@HOST/DATABASE
# DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use a securely generated, stable secret across all production workers.
# OTP_HASH_SECRET=

# Configure at least one real delivery channel. No code is logged or auto-accepted.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Alternative email provider:
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=

# WhatsApp gateway:
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=

# Local development only: print generated OTP codes to the server log when no
# provider is configured. Ignored in production. Never enable on shared systems.
# DEV_OTP_CONSOLE=true
