# Load this file explicitly with uvicorn --env-file after providing real settings.
APP_ENV=development
# Postgres-only. No SQLite fallback. Set a real Postgres URL:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require
# (internal Dokploy network: use ?sslmode=disable)
# DATABASE_URL=
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Use a securely generated, stable secret across all production workers.
# OTP_HASH_SECRET=

# Configure at least one real delivery channel. No code is logged or auto-accepted.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_TLS=starttls
# SMTP_FROM=
# SMTP_USERNAME=
# SMTP_PASSWORD=

# Alternative email provider:
# POSTAL_API_URL=
# POSTAL_SERVER_API_KEY=
# POSTAL_FROM_EMAIL=

# WhatsApp gateway:
# OPENWA_BASE_URL=
# OPENWA_API_KEY=
# OPENWA_SESSION_ID=

# Local development only: print generated OTP codes to the server log when no
# provider is configured. Ignored in production. Never enable on shared systems.
# DEV_OTP_CONSOLE=true
# Local development only: create demo accounts (including a demo super admin)
# on startup. Needs APP_ENV=development or testing as well. Off by default.
# SEED_DEMO_DATA=true

# Two-step sign-in (TOTP) secrets are sealed with this Fernet key. Required
# outside development/testing before anyone can turn 2FA on. Generate with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# TWO_FACTOR_ENCRYPTION_KEY=

# Signs the 30-second check-in pass (QR + 6-digit code). Required outside
# development/testing; without it no pass is issued or verified. Changing it
# invalidates every live code at once.
# PASS_SIGNING_SECRET=

# ── Billing & payments (Razorpay) ─────────────────────────────────────────
# Without these the /api/billing endpoints report an honest "not configured"
# state (503 on checkout, checkoutAvailable=false on /plans) and never charge,
# and order checkout says online payment isn't connected.
# Order payments: mock (default in development/testing; refuses to start in
# production) or razorpay (default in production). docs/billing-payments.md.
# PAYMENT_PROVIDER=mock
# PAYMENT_HOLD_MINUTES=30
# PAYMENT_WEBHOOK_SECRET=            # mock only: signs the generic webhook
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_PLUS_PLAN_ID=plan_student_plus
# RAZORPAY_BASE_URL=https://api.razorpay.com/v1

# ── Video consults (LiveKit) ──────────────────────────────────────────────
# All three or none. Without them POST /api/consultation/{id}/media-token is
# 503 MEDIA_UNAVAILABLE and /state reports liveMedia=false. docs/video-consults.md.
# LIVEKIT_URL=wss://your-project.livekit.cloud   # ws:// only in development/testing
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
