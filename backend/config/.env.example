# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION REFERENCE ONLY — do not copy as-is for local dev.
# Start from root `.env.dev.example` instead. Never commit real values.
# StudentKare Backend Hardened Environment Configuration
# Production Security Checklist & Environment Schema (Senior Security Architect Spec)
# ─────────────────────────────────────────────────────────────────────────

# ── JWT Authentication & Cryptographic Keys (MUST BE RANDOMLY GENERATED) ─
# Production Requirement: 256-bit cryptographically secure random string
# Generate with: `openssl rand -hex 32` or `python3 -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Fernet Encryption-at-Rest Key (Field-Level Encryption) ───────────────
# Generate with: `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=<FILL_VIA_VAULT_FERNET_KEY>

# ── CORS Allowed Origins (Strict FQDN Whitelist) ──────────────────────────
# DO NOT USE wildcard `*` in production environments.
APP_DOMAIN=studentkare.co

# ── ClamAV Virus Scanner (Dokploy global service) ─────────────────────────
# Resolves on the server's internal Docker network; override if your deployment differs.
CLAMAV_HOST=<FILL_VIA_VAULT_INTERNAL_HOST>
CLAMAV_PORT=3310
ALLOWED_ORIGINS=https://studentkare.co,https://www.studentkare.co

# ── Hardened PostgreSQL Connection (SSL/TLS Required) ────────────────────
# Enforces sslmode=verify-full or sslmode=require for transport-layer security
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require

# ── Rate Limiting & Security Defenses ──────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_API_PER_MINUTE=100
MAX_CONTENT_LENGTH_BYTES=10485760

# ── On-Premise Air-Gapped LLM (Ollama Edge Node) ─────────────────────────
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# ── ABDM Gateway Credentials (Ayushman Bharat Digital Mission) ────────────
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=<FILL_VIA_VAULT>
ABDM_CLIENT_SECRET=<FILL_VIA_VAULT>
ABDM_FACILITY_ID=<FILL_VIA_VAULT>

# ── APILayer Service Suite Key (apilayer.com) ─────────────────────────────
# Enables Numverify, Mailboxlayer, Positionstack, pdflayer, Bad Words, Weatherstack, Fixer
APILAYER_API_KEY=your_apilayer_api_key_here