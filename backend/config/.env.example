# ─────────────────────────────────────────────────────────────────────────
# PRODUCTION REFERENCE ONLY — do not copy as-is for local dev.
# Start from root `.env.dev.example` instead. Never commit real values.
# StudentKare Backend Hardened Environment Configuration
# Production Security Checklist & Environment Schema (Senior Security Architect Spec)
# ─────────────────────────────────────────────────────────────────────────

# ── JWT Authentication & Cryptographic Keys (MUST BE RANDOMLY GENERATED) ─
# Production Requirement: 256-bit cryptographically secure random string
# Generate with: `openssl rand -hex 32` or `python3 -c "import secrets; print(secrets.token_hex(32))"`
JWT_SECRET=<FILL_VIA_VAULT_64_HEX_CHARS_MIN>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Fernet Encryption-at-Rest Key (Field-Level Encryption) ───────────────
# Generate with: `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
FERNET_KEY=<FILL_VIA_VAULT_FERNET_KEY>

# ── CORS Allowed Origins (Strict FQDN Whitelist) ──────────────────────────
# DO NOT USE wildcard `*` in production environments.
APP_DOMAIN=studentkare.co

# ── ClamAV Virus Scanner (Dokploy global service) ─────────────────────────
# Resolves on the server's internal Docker network; override if your deployment differs.
CLAMAV_HOST=<FILL_VIA_VAULT_INTERNAL_HOST>
CLAMAV_PORT=3310
ALLOWED_ORIGINS=https://studentkare.co,https://www.studentkare.co

# ── Hardened PostgreSQL Connection (SSL/TLS Required) ────────────────────
# Enforces sslmode=verify-full or sslmode=require for transport-layer security
DATABASE_URL=postgresql://<USER>:<PASSWORD>@<HOST>:5432/<DB>?sslmode=require

# ── Rate Limiting & Security Defenses ──────────────────────────────────────
RATE_LIMIT_LOGIN_PER_MINUTE=5
# General API limits live in the settings registry (platform.api_rate_per_account_per_minute
# = 300, platform.api_rate_per_ip_per_minute = 3000). Set these only to pin a value for one
# deployment (e.g. a load test). RATE_LIMIT_API_PER_MINUTE is retired and ignored.
# RATE_LIMIT_API_PER_ACCOUNT_PER_MINUTE=300
# RATE_LIMIT_API_PER_IP_PER_MINUTE=3000
MAX_CONTENT_LENGTH_BYTES=10485760

# ── On-Premise Air-Gapped LLM (Ollama Edge Node) ─────────────────────────
# Opt-in. Unset, Agent Ayush answers extractively (quotes approved passages).
# Set, Ayush asks the model to rephrase retrieved passages only, through the AI
# constitution (services/llm_gateway.py); any failure falls back to quoting.
# OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
LLM_TIMEOUT_SECONDS=8
LLM_RETRY_AFTER_SECONDS=30

# ── ABDM Gateway Credentials (Ayushman Bharat Digital Mission) ────────────
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=<FILL_VIA_VAULT>
ABDM_CLIENT_SECRET=<FILL_VIA_VAULT>
ABDM_FACILITY_ID=<FILL_VIA_VAULT>

# ── APILayer Service Suite Key (apilayer.com) ─────────────────────────────
# Enables Numverify, Mailboxlayer, Positionstack, pdflayer, Bad Words, Weatherstack, Fixer
APILAYER_API_KEY=your_apilayer_api_key_here

# ── Slack Ops Alerts (SuperAdmin → Integrations → Slack) ───────────────────
# Bot token from your Slack app (OAuth & Permissions, chat:write scope).
# Prefer the SuperAdmin UI (persisted to DB); env values seed first boot.
SLACK_ENABLED=false
SLACK_BOT_TOKEN=
SLACK_DEFAULT_CHANNEL=
SLACK_OPS_CHANNEL=
SLACK_BOOKING_CHANNEL=

# ── Integrations Secrets Envelope Key (at-rest encryption) ────────────────
# Fernet key dedicated to care_system_settings secrets. MUST differ from FERNET_KEY.
# Generate with: `python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"`
# Unset/missing => secrets stored as today (plaintext) with a startup warning.
INTEGRATIONS_ENCRYPTION_KEY=

# DPDP account erasure (services/erasure.py). Erasure stays paused until both are set.
# Key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Retention: days the sealed archive is kept before it is destroyed. Confirm with legal counsel.
DPDP_ARCHIVE_KEY=
DPDP_ARCHIVE_RETENTION_DAYS=
