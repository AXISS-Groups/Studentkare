# ─────────────────────────────────────────────────────────────────────────
# StudentKare Backend Environment Configuration
# Copy this file to `.env` and fill in your values. Never commit `.env`.
# ─────────────────────────────────────────────────────────────────────────

# JWT signing secret (REQUIRED in production). Use a long random value.
JWT_SECRET=change_me_to_a_long_random_secret
JWT_ALGORITHM=HS256

# CORS allowed origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Persistence ──────────────────────────────────────────────────────────
# PostgreSQL (recommended). Leave unset to fall back to SQLite.
DATABASE_URL=postgresql://studentkare:password@localhost:5432/studentkare
# DATABASE_URL=sqlite:///./studentkare.db

# ── On-prem LLM (Ollama) ─────────────────────────────────────────────────
# Leave unset to run in deterministic fallback mode.
OLLAMA_URL=http://localhost:11434
LLM_MODEL=llama3.1:8b
EMBED_MODEL=nomic-embed-text

# ── Automation (n8n) ─────────────────────────────────────────────────────
# Leave unset to run in local fallback mode.
N8N_WEBHOOK_BASE_URL=http://localhost:5678

# ── WhatsApp delivery (OpenWA self-hosted gateway) ───────────────────────
# Leave unset to simulate delivery.
OPENWA_BASE_URL=
OPENWA_API_KEY=
OPENWA_SESSION_ID=
OPENWA_DEFAULT_COUNTRY_CODE=91

# ── Email delivery (Postal / SendGrid / Gmail) ───────────────────────────
POSTAL_API_URL=
POSTAL_SERVER_API_KEY=
POSTAL_FROM_EMAIL=
SENDGRID_API_KEY=
GMAIL_SMTP=

# ── ABDM (Ayushman Bharat Digital Mission) gateway ───────────────────────
ABDM_BASE_URL=https://sandbox.abdm.gov.in
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_FACILITY_ID=IN3610002491

# ── Optional MongoDB (legacy modules: core.email / core.whatsapp) ────────
# Only required if you use the Mongo-backed legacy tooling.
MONGO_URL=
DB_NAME=studentkare
